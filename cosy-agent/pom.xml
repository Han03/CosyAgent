<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

        <parent>
        <groupId>com.cosy</groupId>
        <artifactId>cosy-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>cosy-agent</artifactId>
    <name>cosy-agent</name>
    <description>基于 Spring AI 的企业级 ReAct 智能体基础框架</description>

    <properties>
    </properties>

    

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Jackson JSR310：Stream 消费端 JSON 解析 Instant 字段（BOM 管版本） -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- Spring AI：OpenAI 兼容模型接入，ReAct 推理循环 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- Redis：多层记忆存储（实现 RedisMemoryStore） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Nacos（P1：服务注册发现 + 配置中心）。
             2025.x 起必须走 spring.config.import 导入配置（bootstrap 方式已废弃）；
             配置上收后本地 application.yml 同名段保留为兜底（optional 导入）。 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>

        <!-- P3.1 服务间调用：OpenFeign（知识库 cosy-knowledge 客户端）+ 客户端负载均衡（lb:// 寻址） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!-- P4.1 异步化：Spring Cloud Stream RocketMQ binder。
             LLM 调用记录异步管道（topic llm-call-log）+ 能力变更事件订阅（topic capability-change）。
             版本由 SCA 2025.1.0.0 BOM 管理（rocketmq 5.3.1）。 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-stream-rocketmq</artifactId>
        </dependency>

        <!-- Redisson（P0：记忆层分布式化，替代 Lettuce 直连）。
             redisson-spring-boot-starter 提供 RedissonClient 自动装配；
             redisson-spring-data-40 为 Spring Boot 4.0 / Spring Data Redis 4.0 的集成模块
             （版本必须与 starter 保持一致，由 Redisson 官方 compatibility 矩阵约束）。 -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
            <version>${redisson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-data-40</artifactId>
            <version>${redisson.version}</version>
        </dependency>

        <!-- Resilience4j：LLM/工具调用容错（启用策略配置，见设计方案第 7 节）。
             Spring Boot 4 起 BOM 不再管理 starter-aop（Boot 4 移除该 starter）；
             项目容错为纯编程式 Registry API（ResilienceSupport），无 AOP 注解使用，
             因此不再引入 AOP starter，Resilience4j boot4 starter 自带所需 aspectj 依赖。 -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot4</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>

        <!-- 业务数据 MySQL 存储（cosy.agent.persistence=mysql 时生效） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- MyBatis-Plus（v2 方案：业务 CRUD 统一收口 MP，消除手写 JDBC；
             DataSource 仅 persistence=mysql 时装配，memory 模式不触发 MyBatis 初始化） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
            <version>3.5.17</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Boot 4：MockMvc 测试自动配置拆分为独立模块（@AutoConfigureMockMvc 位于
             org.springframework.boot.webmvc.test.autoconfigure） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
